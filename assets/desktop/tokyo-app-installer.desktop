[Desktop Entry]
Name=App Installer
GenericName=Arch Linux & AUR App Installer
Comment=Beliebte Programme interaktiv via yay & pacman installieren
Exec=sh -c 'for p in "$HOME/.local/bin/tokyo-app-installer" "$HOME/.config/hypr/scripts/tokyo-app-installer" "$HOME/arch-hyprland/scripts/tokyo-app-installer" "$HOME/tokyo-hypr-dots/scripts/tokyo-app-installer" "$HOME/Desktop/hyprland/tokyo-hypr-dots/scripts/tokyo-app-installer"; do if [ -f "$p" ]; then exec bash "$p" "$@"; fi; done; PATH="$HOME/.local/bin:$HOME/.config/hypr/scripts:$PATH" exec tokyo-app-installer "$@"' _ %u
Icon=system-software-install
Terminal=false
Type=Application
Categories=System;Settings;PackageManager;Utility;
Keywords=apps;app installer;installer;software;install;yay;aur;tokyo;spotify;steam;heroic;discord;vesktop;chrome;zen;vscode;obsidian;btop;vlc;nmap;wireshark;burpsuite;metasploit;ghidra;security;cyber;pentest;blackarch;
