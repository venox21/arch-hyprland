[Desktop Entry]
Name=System Cleaner
GenericName=Arch Linux Maintenance & Cleanup
Comment=Paket-Caches, verwaiste Pakete und System-Logs bereinigen
Exec=sh -c 'PATH="$HOME/.local/bin:$HOME/.config/hypr/scripts:$PATH" exec tokyo-cleaner "$@"' _ %u
Icon=edit-clear
Terminal=false
Type=Application
Categories=System;Settings;Utility;
Keywords=clean;cleaner;maintenance;cache;pacman;yay;logs;tokyo;system;
