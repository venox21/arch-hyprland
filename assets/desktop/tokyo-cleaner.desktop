[Desktop Entry]
Name=System Cleaner
GenericName=Arch Linux Maintenance & Cleanup
Comment=Paket-Caches, verwaiste Pakete und System-Logs bereinigen
Exec=kitty --class tokyo-system-cleaner --title "System Cleaner" -e bash -c "if [[ -x \"${HOME}/.config/hypr/scripts/clean-system.sh\" ]]; then \"${HOME}/.config/hypr/scripts/clean-system.sh\"; else bash \"$(dirname \"$(readlink -f \"$0\" 2>/dev/null || echo \"$HOME\")\")/../scripts/clean-system.sh\"; fi; echo ''; read -r -p 'Drücke Enter zum Schließen...' _dummy"
Icon=edit-clear
Terminal=false
Type=Application
Categories=System;Settings;Utility;
Keywords=clean;cleaner;maintenance;cache;pacman;yay;logs;tokyo;system;
