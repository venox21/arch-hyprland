{
    // ╔══════════════════════════════════════════════════════════╗
    // ║  Waybar – Bottom Dock (Schwebendes Dock unten)           ║
    // ╚══════════════════════════════════════════════════════════╝

    "layer": "top",
    "position": "bottom",
    "height": 40,
    "spacing": 4,
    "margin-bottom": 8,
    "margin-left": 16,
    "margin-right": 16,
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,

    // ── Module: Links ────────────────────────────────────────
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],

    // ── Module: Mitte ────────────────────────────────────────
    "modules-center": [
        "clock"
    ],

    // ── Module: Rechts ───────────────────────────────────────
    "modules-right": [
        "tray",
        "network",
        "pulseaudio",
        "battery",
        "custom/swaync",
        "custom/settings",
        "custom/power"
    ],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1",
        "all-outputs": false,
        "sort-by-number": true,
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5]
        }
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 45,
        "rewrite": {
            "(.*) — Mozilla Firefox": "🌐 $1",
            "(.*) - kitty": "🖥 $1",
            "(.*) - Thunar": "📁 $1"
        },
        "separate-outputs": true
    },

    "clock": {
        "format": "  {:%H:%M}",
        "format-alt": "  {:%A, %d. %B %Y  %H:%M:%S}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "left",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#7aa2f7'><b>{}</b></span>",
                "days": "<span color='#c0caf5'>{}</span>",
                "weeks": "<span color='#73daca'><b>KW{}</b></span>",
                "weekdays": "<span color='#bb9af7'><b>{}</b></span>",
                "today": "<span color='#f7768e'><b><u>{}</u></b></span>"
            }
        },
        "interval": 1
    },

    "network": {
        "format-wifi": "  {signalStrength}%",
        "format-ethernet": "  {bandwidthTotalBits}",
        "format-linked": "  Verbunden",
        "format-disconnected": "  Getrennt",
        "interval": 5,
        "on-click": "$HOME/.config/hypr/scripts/control-center.sh --wifi-menu"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " Stumm",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "tooltip-format": "{desc}: {volume}%",
        "on-click": "pamixer -t",
        "on-click-right": "pavucontrol",
        "on-scroll-up": "pamixer -i 2",
        "on-scroll-down": "pamixer -d 2"
    },

    "battery": {
        "states": {
            "good": 80,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "Akku: {capacity}%"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8,
        "show-passive-items": true
    },

    "custom/swaync": {
        "tooltip": true,
        "tooltip-format": "Kontrollzentrum",
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂚",
            "dnd-notification": "󰂛",
            "dnd-none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "$HOME/.config/hypr/scripts/control-center.sh --toggle",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "custom/settings": {
        "format": "",
        "tooltip": true,
        "tooltip-format": "Einstellungen",
        "on-click": "~/.config/hypr/scripts/settings.sh"
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": true,
        "tooltip-format": "Power-Menü",
        "on-click": "~/.config/hypr/scripts/power-menu.sh"
    }
}
