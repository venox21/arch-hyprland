/* ╔══════════════════════════════════════════════════════════════╗
 * ║  Rofi – Tokyo Night Transparent & Modern Theme              ║
 * ║  Frosted Glass & Glassmorphism für Hyprland                 ║
 * ╚══════════════════════════════════════════════════════════════╝ */

configuration {
    modi:                "drun,run,filebrowser,window";
    show-icons:          true;
    icon-theme:          "Papirus-Dark";
    display-drun:        "  Apps";
    display-run:         "  Ausführen";
    display-filebrowser: "  Dateien";
    display-window:      "  Fenster";
    drun-display-format: "{name}";
    font:                "JetBrainsMono Nerd Font 11";
    click-to-exit:       true;
    steal-focus:         true;
}

/* ── Globale Farben (Tokyo Night Glassmorphism) ──────────────── */
* {
    bg:           rgba(26, 27, 38, 0.70);
    bg-alt:       rgba(36, 40, 59, 0.53);
    bg-selected:  rgba(122, 162, 247, 0.22);
    fg:           #c0caf5;
    fg-alt:       #787c99;
    blue:         #7aa2f7;
    cyan:         #7dcfff;
    magenta:      #bb9af7;
    red:          #f7768e;
    green:        #9ece6a;
    teal:         #73daca;
    border:       rgba(122, 162, 247, 0.45);

    border-radius: 10px;
    margin:        0px;
    padding:       0px;
    spacing:       0px;
}

/* ── Fenster (Transparenter Frosted-Glass Rahmen) ─────────────── */
window {
    width:            580px;
    background-color: @bg;
    border:           1px;
    border-color:     @border;
    border-radius:    16px;
    padding:          14px;
}

/* ── Hauptcontainer ───────────────────────────────────────────── */
mainbox {
    background-color: transparent;
    spacing:          10px;
    children:         [ inputbar, message, listview ];
}

/* ── Eingabefeld (Transparente schwebende Leiste) ─────────────── */
inputbar {
    background-color: @bg-alt;
    border:           1px;
    border-color:     rgba(122, 162, 247, 0.25);
    border-radius:    12px;
    padding:          10px 14px;
    spacing:          12px;
    children:         [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color:       @blue;
    font:             "JetBrainsMono Nerd Font Bold 12";
}

entry {
    background-color:  transparent;
    text-color:        @fg;
    placeholder:       "Apps suchen...";
    placeholder-color: @fg-alt;
}

/* ── Nachrichtenbereich ───────────────────────────────────────── */
message {
    background-color: transparent;
    padding:          2px 0px;
}

textbox {
    background-color: @bg-alt;
    text-color:       @fg-alt;
    padding:          10px 14px;
    border-radius:    10px;
    border:           1px;
    border-color:     rgba(122, 162, 247, 0.15);
}

/* ── Liste ────────────────────────────────────────────────────── */
listview {
    background-color: transparent;
    lines:            8;
    columns:          1;
    fixed-height:     false;
    spacing:          4px;
    scrollbar:        false;
}

/* ── Listenelemente (Sleek Hover & Active Glow) ───────────────── */
element {
    background-color: transparent;
    text-color:       @fg;
    padding:          9px 12px;
    border-radius:    10px;
    spacing:          12px;
    border:           1px;
    border-color:     transparent;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

element normal.urgent {
    background-color: rgba(247, 118, 142, 0.25);
    text-color:       @red;
    border-color:     @red;
}

element normal.active {
    background-color: rgba(115, 218, 202, 0.15);
    text-color:       @teal;
    border-color:     @teal;
}

element selected.normal {
    background-color: @bg-selected;
    text-color:       #ffffff;
    border-color:     rgba(122, 162, 247, 0.50);
}

element selected.urgent {
    background-color: rgba(247, 118, 142, 0.40);
    text-color:       #ffffff;
    border-color:     @red;
}

element selected.active {
    background-color: rgba(122, 162, 247, 0.35);
    text-color:       #ffffff;
    border-color:     @blue;
}

element-icon {
    background-color: transparent;
    size:             26px;
    vertical-align:   0.5;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    highlight:        bold #7aa2f7;
}
