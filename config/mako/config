# ╔══════════════════════════════════════════════════════════════╗
# ║  Mako – Benachrichtigungen (Tokyo Night)                     ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Allgemein ─────────────────────────────────────────────────
sort=-time
layer=overlay
anchor=top-right
max-visible=5
default-timeout=5000

# ── Aussehen ──────────────────────────────────────────────────
font=JetBrainsMono Nerd Font 10
width=340
height=120
margin=8
padding=12
border-size=2
border-radius=10
icons=1
max-icon-size=48
icon-location=left

# ── Tokyo Night Farben ────────────────────────────────────────
background-color=#24283bf0
text-color=#c0caf5
border-color=#7aa2f7

# ── Fortschritt ───────────────────────────────────────────────
progress-color=over #7aa2f7

# ── Aktionen ──────────────────────────────────────────────────
on-button-left=dismiss
on-button-middle=none
on-button-right=dismiss-all
on-touch=dismiss

# ── Gruppierung ───────────────────────────────────────────────
[grouped]
format=<b>%s</b>\n%b
text-color=#a9b1d6

# ── Dringende Benachrichtigungen ──────────────────────────────
[urgency=high]
border-color=#f7768e
text-color=#f7768e
default-timeout=10000

# ── Niedrige Priorität ───────────────────────────────────────
[urgency=low]
border-color=#33467c
text-color=#a9b1d6
default-timeout=3000
