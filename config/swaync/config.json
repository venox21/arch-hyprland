{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "top",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 10,
  "control-center-margin-bottom": 10,
  "control-center-margin-right": 12,
  "control-center-margin-left": 0,
  "control-center-width": 390,
  "control-center-height": 780,
  "fit-to-screen": false,
  "notification-window-width": 370,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": [
    "title",
    "buttons-grid#quick-top",
    "buttons-grid#quick-sub",
    "volume",
    "backlight",
    "mpris",
    "label#notif-header",
    "notifications",
    "buttons-grid#bottom-bar"
  ],
  "widget-config": {
    "title": {
      "text": "Quick Settings",
      "clear-all-button": true,
      "button-text": "✕ Close"
    },
    "buttons-grid#quick-top": {
      "buttons-per-row": 3,
      "actions": [
        {
          "label": "󰖩  WLAN\nHyperNet",
          "type": "toggle",
          "active": true,
          "command": "sh -c '$HOME/.config/hypr/scripts/control-center.sh --wifi-menu'",
          "update-command": "sh -c '$HOME/.config/hypr/scripts/control-center.sh --wifi-status'"
        },
        {
          "label": "󰂯  Bluetooth\nHeadphones",
          "type": "toggle",
          "active": false,
          "command": "sh -c '$HOME/.config/hypr/scripts/control-center.sh --bluetooth-menu'",
          "update-command": "sh -c '$HOME/.config/hypr/scripts/control-center.sh --bluetooth-status'"
        },
        {
          "label": "󰖔\nNight Light",
          "type": "toggle",
          "active": false,
          "command": "sh -c '$HOME/.config/hypr/scripts/control-center.sh --nightmode-toggle'",
          "update-command": "sh -c '$HOME/.config/hypr/scripts/control-center.sh --nightmode-status'"
        }
      ]
    },
    "buttons-grid#quick-sub": {
      "buttons-per-row": 3,
      "actions": [
        {
          "label": "󰂛\nDo Not Disturb",
          "type": "toggle",
          "active": false,
          "command": "swaync-client -d -sw",
          "update-command": "sh -c '[[ $(swaync-client -D) == \"true\" ]] && echo true || echo false'"
        },
        {
          "label": "󰀝\nAirplane Mode",
          "type": "toggle",
          "active": false,
          "command": "sh -c '$HOME/.config/hypr/scripts/control-center.sh --airplane-toggle'",
          "update-command": "sh -c '$HOME/.config/hypr/scripts/control-center.sh --airplane-status'"
        },
        {
          "label": "󰔎\nDark Mode",
          "type": "normal",
          "command": "sh -c '$HOME/.config/hypr/scripts/control-center.sh --theme-toggle'"
        }
      ]
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": false,
      "show-per-app-icon": false,
      "show-per-app-label": false,
      "expand-per-app": false
    },
    "backlight": {
      "label": "󰃟"
    },
    "mpris": {
      "image-size": 58,
      "image-radius": 12,
      "show-album-art": "when-available",
      "autohide": false
    },
    "label#notif-header": {
      "text": "Notifications",
      "max-lines": 1
    },
    "buttons-grid#bottom-bar": {
      "buttons-per-row": 4,
      "actions": [
        {
          "label": "󰂛",
          "type": "toggle",
          "command": "swaync-client -d -sw",
          "update-command": "sh -c '[[ $(swaync-client -D) == \"true\" ]] && echo true || echo false'"
        },
        {
          "label": "󰌾",
          "type": "normal",
          "command": "hyprlock"
        },
        {
          "label": "󰐥",
          "type": "normal",
          "command": "sh -c '$HOME/.config/hypr/scripts/power-menu.sh'"
        },
        {
          "label": "󰒓",
          "type": "normal",
          "command": "sh -c '$HOME/.config/hypr/scripts/settings.sh'"
        }
      ]
    }
  }
}
