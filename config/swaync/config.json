{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "top",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 10,
  "control-center-margin-bottom": 10,
  "control-center-margin-right": 10,
  "control-center-margin-left": 0,
  "control-center-width": 390,
  "control-center-height": 680,
  "fit-to-screen": false,
  "notification-window-width": 360,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": [
    "title",
    "dnd",
    "buttons-grid",
    "volume",
    "backlight",
    "mpris",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Kontrollzentrum",
      "clear-all-button": true,
      "button-text": "Alle löschen"
    },
    "dnd": {
      "text": "Nicht stören (DND)"
    },
    "buttons-grid": {
      "buttons-per-row": 2,
      "actions": [
        {
          "label": "󰤨  WLAN",
          "type": "toggle",
          "active": true,
          "command": "sh -c '$HOME/.config/hypr/scripts/control-center.sh --wifi-menu'",
          "update-command": "sh -c '$HOME/.config/hypr/scripts/control-center.sh --wifi-status'"
        },
        {
          "label": "󰂯  Bluetooth",
          "type": "toggle",
          "active": false,
          "command": "sh -c '$HOME/.config/hypr/scripts/control-center.sh --bluetooth-menu'",
          "update-command": "sh -c '$HOME/.config/hypr/scripts/control-center.sh --bluetooth-status'"
        },
        {
          "label": "󰕾  Audio",
          "type": "normal",
          "command": "sh -c '$HOME/.config/hypr/scripts/control-center.sh --audio-toggle'"
        },
        {
          "label": "󰖔  Nachtlicht",
          "type": "toggle",
          "active": false,
          "command": "sh -c '$HOME/.config/hypr/scripts/control-center.sh --nightmode-toggle'",
          "update-command": "sh -c '$HOME/.config/hypr/scripts/control-center.sh --nightmode-status'"
        },
        {
          "label": "󰔎  Farbschema",
          "type": "normal",
          "command": "sh -c '$HOME/.config/hypr/scripts/control-center.sh --theme-toggle'"
        },
        {
          "label": "󱈑  Sparmodus",
          "type": "toggle",
          "active": false,
          "command": "sh -c '$HOME/.config/hypr/scripts/control-center.sh --powersave-toggle'",
          "update-command": "sh -c '$HOME/.config/hypr/scripts/control-center.sh --powersave-status'"
        },
        {
          "label": "󰊴  GameMode",
          "type": "toggle",
          "active": false,
          "command": "sh -c '$HOME/.config/hypr/scripts/control-center.sh --gamemode-toggle'",
          "update-command": "sh -c '$HOME/.config/hypr/scripts/control-center.sh --gamemode-status'"
        },
        {
          "label": "󰃢  Cleaner",
          "type": "normal",
          "command": "sh -c '$HOME/.config/hypr/scripts/control-center.sh --cleaner'"
        }
      ]
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": true,
      "show-per-app-icon": true,
      "show-per-app-label": true,
      "expand-per-app": false,
      "empty-list-label": "Keine aktiven Audio-Streams"
    },
    "backlight": {
      "label": "󰃟"
    },
    "mpris": {
      "image-size": 72,
      "image-radius": 10,
      "show-album-art": "when-available",
      "autohide": true
    }
  }
}
