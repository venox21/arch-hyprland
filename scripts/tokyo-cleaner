#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════════════╗
# ║  Tokyo Night – System-Cleaner CLI Starter & Wrapper          ║
# ╚══════════════════════════════════════════════════════════════╝
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP=""

for candidate in \
    "${SCRIPT_DIR}/clean-system.sh" \
    "${HOME}/.config/hypr/scripts/clean-system.sh" \
    "${HOME}/arch-hyprland/scripts/clean-system.sh" \
    "${HOME}/arch-hyrland/scripts/clean-system.sh" \
    "${HOME}/tokyo-hypr-dots/scripts/clean-system.sh" \
    "${HOME}/Desktop/hyprland/tokyo-hypr-dots/scripts/clean-system.sh"; do
    if [[ -f "${candidate}" ]]; then
        APP="${candidate}"
        break
    fi
done

if [[ -z "${APP}" || ! -f "${APP}" ]]; then
    echo "Fehler: scripts/clean-system.sh nicht gefunden!" >&2
    if command -v notify-send &>/dev/null; then
        notify-send -u critical -i dialog-error "System Cleaner" "Skript clean-system.sh nicht gefunden. Bitte ./update.sh ausführen."
    fi
    exit 1
fi

if [ -t 0 ] && [ -t 1 ]; then
    exec bash "${APP}" "$@"
fi

if command -v kitty &>/dev/null; then
    exec kitty --class tokyo-system-cleaner --title "System Cleaner" bash "${APP}" "$@"
else
    exec bash "${APP}" "$@"
fi
